---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CONTACT_EMAIL } from '../../consts';
const info = [
  { label: "분야", value: "여행 매칭 서비스" },
  { label: "대상", value: "한국 방문 외국인" },
  { label: "연결 도시", value: "서울 외 지방 도시" },
  { label: "상태", value: "구상 중" },
];
---
<!doctype html>
<html lang="ko">
<head><BaseHead title="까치 서울 (가칭) | mulkkachi" description="한국을 방문한 외국인이 서울 밖 지방 도시를 만날 수 있도록 잇는 여행 매칭 서비스." image="/images/city-question/kkachi-seoul.jpg" /></head>
<body>
  <Header />
  <section class="container">
    <a href="/city-question" class="btn btn-ghost" style="padding-inline:0;margin-bottom:var(--space-6);display:inline-block">← 도시질문</a>
    <img src="/images/city-question/kkachi-seoul.jpg" alt="까치 서울" style="width:100%;max-height:480px;object-fit:cover;border-radius:6px;margin-bottom:var(--space-8)" />
    <div style="display:grid;grid-template-columns:280px 1fr;gap:var(--space-8);align-items:start">
      <div class="card blueprint" style="padding:var(--space-6);position:sticky;top:var(--space-6)">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <div class="card-kicker" style="color:var(--color-scarlet);margin-bottom:var(--space-4)">서비스 정보</div>
        {info.map(i => (
          <div style="padding:var(--space-3) 0;border-top:1px solid var(--color-divider)">
            <div style="font-size:13px;opacity:0.6;margin-bottom:2px">{i.label}</div>
            <div style="font-size:16px;font-weight:600">{i.value}</div>
          </div>
        ))}
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-secondary" style="width:100%;margin-top:var(--space-4);text-align:center;display:block">서비스 바로가기</a>
      </div>
      <div>
        <div class="card-kicker" style="color:var(--color-scarlet);margin-bottom:var(--space-2)">PJ.001 · 구상 중</div>
        <h1 style="font-size:clamp(28px,3.6vw,44px);margin-bottom:var(--space-6)">까치 서울 (가칭)</h1>
        <div class="prose">
          <h3>기획 의도</h3>
          <p>한국을 방문하는 외국인 대부분의 여정이 서울에 머문다. 까치 서울은 그 여정을 서울 밖 지방 도시로 잇는 매칭 서비스를 구상하고 있다.</p>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</body>
</html>
