---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const cityQuestions = (await getCollection('cityQuestion')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="ko">
<head><BaseHead title="도시질문 | mulkkachi" description="지방 도시 선택을 둘러싼 질문과 실험의 기록" /></head>
<body>
	<Header />
	<section class="container">
		<div class="card-kicker" style="margin-bottom:var(--space-2)">도시질문</div>
		<h1 style="font-size:clamp(36px,4.5vw,60px);margin-bottom:var(--space-2)">지방 도시 선택을 둘러싼 질문과 실험의 기록</h1>
		<p style="font-size:17px;opacity:0.7;margin:0 0 var(--space-8)">대한민국 서울 그리고 서울외 도시에 대한 질문들</p>

		<div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-6);align-items:start">
			<div>
				<div class="tag tag-outline" style="margin-bottom:var(--space-4)">도시질문</div>
				<div style="display:flex;flex-direction:column;gap:var(--space-4)">
					{cityQuestions.map(c => (
						<a href={`/city-question/${c.id}`} class="card blueprint elev-sm" style="text-decoration:none;color:inherit;padding:0;overflow:hidden">
							<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
							<img src={c.data.heroImage} alt={c.data.title} style="width:100%;height:220px;object-fit:cover" />
							<div style="padding:var(--space-6)">
								<div class="card-kicker" style="color:var(--color-scarlet)">{c.data.code} · {c.data.status}</div>
								<div class="card-title" style="font-size:22px">{c.data.title}</div>
								<p class="card-body">{c.data.desc}</p>
								<div class="card-meta">{c.data.pubDate.toISOString().slice(0,10)}</div>
							</div>
						</a>
					))}
				</div>
			</div>

			<div style="position:sticky;top:var(--space-6)">
				<div class="tag tag-outline" style="margin-bottom:var(--space-4)">까치 서울</div>
				<div class="card blueprint" style="position:relative;padding:0;overflow:hidden;min-height:420px;display:flex;flex-direction:column;justify-content:flex-end">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
					<img src="/images/city-question/kkachi-seoul.jpg" alt="까치 서울" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" />
					<div style="position:relative;z-index:1;background:linear-gradient(0deg, color-mix(in srgb, var(--color-prussian) 85%, transparent), transparent 60%);padding:var(--space-6)">
						<div class="card-kicker" style="color:#fff;opacity:0.85">PJ.001 · 구상 중</div>
						<div class="card-title" style="font-size:24px;color:#fff">까치 서울 (가칭)</div>
						<p class="card-body" style="color:rgba(255,255,255,0.85)">한국을 방문한 외국인이 서울 밖 지방 도시를 만날 수 있도록 잇는 여행 매칭 서비스.</p>
						<div class="card-meta" style="color:rgba(255,255,255,0.7)">2026.08</div>
					</div>
				</div>
				<p style="font-size:14px;line-height:1.8;margin-top:var(--space-4);opacity:0.8">한국을 방문하는 외국인 대부분의 여정이 서울에 머문다. 까치 서울은 그 여정을 서울 밖 지방 도시로 잇는 매칭 서비스를 구상하고 있다.</p>
			</div>
		</div>
	</section>
	<Footer />
</body>
</html>
