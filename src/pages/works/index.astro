---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).filter(w => !w.data.draft).sort((a, b) => a.data.order - b.data.order);
const archive = [
	{ year: '2025', items: ['용마루 숲길 축제', '용마루길 미스터리 쇼퍼 기획 및 운영 관리'] },
	{ year: '2024', items: ['용마루길 SNS 채널 운영', '용마루길 소비자 FGI 및 간담회 운영 관리', '상인 마케팅 교육 프로그램 기획 및 운영 관리'] },
	{ year: '2023', items: ['홍수골 막걸리 광장시장 팝업', '웹예능 창신동 스파이 찌디', '창신동 마을 웹진 〈주간창신〉 제작 관리', '홍수골 막걸리 애니메이션 〈창신동 수호신, 좌청룡〉 기획 및 콘텐츠 디렉션', '창신동 로컬브랜드 축제 〈흥인창신 시즌 2: 홍수골 막걸리 페스타〉 기획 및 관리 총괄', '상점 광고 콘텐츠 〈메이드 인 로컬, 창신 CF 제작소〉 기획 및 제작 관리'] },
	{ year: '2022', items: ['난곡사람, 난곡상인', '창신동 로컬브랜드 축제 〈흥인창신〉 기획 및 관리', '창신동 로컬 콘텐츠·막걸리 기획 및 운영 관리', '마을여행 프로그램 〈난곡동 원데이 트립〉 기획 및 파일럿 운영'] },
];
---
<!doctype html>
<html lang="ko">
<head><BaseHead title="웍스 | mulkkachi" description="물까치가 진행한 프로젝트와 작업 기록" /></head>
<body>
	<Header />
	<section class="container">
		<h1 style="font-size:clamp(36px,4.5vw,60px);margin-bottom:var(--space-2)">웍스</h1>
		<p style="font-size:17px;opacity:0.7;margin:0 0 var(--space-6)">고유한 것을 찾아, 이야기로 만든 기록.</p>
		<div style="display:flex;flex-direction:column;gap:var(--space-3);margin-bottom:var(--space-8)">
			{works.map(w => (
				<a href={`/works/${w.id}`} class="card blueprint" style="text-decoration:none;color:inherit;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-4);padding:var(--space-4)">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
					<div class="tag tag-outline">{w.data.tag}</div>
					<div class="card-title" style="font-size:clamp(19px,2vw,25px);text-align:center;flex:1;min-width:200px">{w.data.title}</div>
					<div style="font-size:12px;opacity:0.6;max-width:260px">{w.data.category}</div>
				</a>
			))}
		</div>

		<h3 style="font-size:clamp(26px,3vw,38px);font-weight:800;color:var(--color-text);margin-bottom:var(--space-6);border-bottom:3px solid var(--color-text);padding-bottom:var(--space-2);display:inline-block">주요 프로젝트</h3>
		<div style="display:flex;flex-direction:column;gap:var(--space-6)">
			{archive.map(yr => (
				<div>
					<div style="font-family:var(--font-heading);font-weight:var(--font-heading-weight);font-size:20px;color:var(--color-accent);margin-bottom:var(--space-2)">{yr.year}</div>
					<div style="display:flex;flex-direction:column;gap:var(--space-2)">
						{yr.items.map(item => (
							<div style="font-size:15px;line-height:1.6;padding-left:var(--space-3);border-left:1px solid var(--color-divider)">{item}</div>
						))}
					</div>
				</div>
			))}
		</div>
	</section>
	<Footer />
</body>
</html>
