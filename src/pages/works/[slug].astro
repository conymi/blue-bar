---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { CONTACT_EMAIL } from '../../consts';

export async function getStaticPaths() {
	const works = (await getCollection('works')).filter(w => !w.data.draft);
	return works.map(w => ({ params: { slug: w.id }, props: { work: w, works } }));
}

const { work, works } = Astro.props;
const { Content } = await render(work);
const idx = works.findIndex(w => w.id === work.id);
const prevWork = works[(idx - 1 + works.length) % works.length];
const nextWork = works[(idx + 1) % works.length];
---
<!doctype html>
<html lang="ko">
<head><BaseHead title={`${work.data.title} | mulkkachi`} description={work.data.quote} image={work.data.heroImage} /></head>
<body>
	<Header />
	<section class="container" style="max-width:1120px">
		<a href="/works" class="btn btn-ghost" style="padding-inline:0;margin-bottom:var(--space-6);display:inline-block">← 웍스</a>

		<div style="margin-bottom:var(--space-6)">
			{work.data.heroVideo
				? <video src={work.data.heroVideo} controls playsinline style="width:100%;height:360px;object-fit:contain;background:#000"></video>
				: <img src={work.data.heroImage} alt={work.data.title} style="width:100%;height:360px;object-fit:cover" />}
		</div>

		<div style="display:grid;grid-template-columns:260px 1fr;gap:var(--space-6)">
			<div>
				<div class="card blueprint" style="padding:var(--space-2)">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
					<h3 style="font-size:10px;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-accent);margin-bottom:6px">프로젝트 정보</h3>
					<div style="display:flex;flex-direction:column">
						{work.data.info.map((row, i) => (
							<div style={`padding:6px 0;${i < work.data.info.length - 1 ? 'border-bottom:1px solid var(--color-divider)' : ''}`}>
								<div style="font-size:10px;letter-spacing:0.02em;opacity:0.55">{row.label}</div>
								<div style="font-size:12px;font-weight:600;line-height:1.3">{row.value}</div>
							</div>
						))}
					</div>
				</div>
			</div>
			<div>
				<h1 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:var(--space-6)">{work.data.title}</h1>
				<div style="border-left:2px solid var(--color-scarlet);padding-left:var(--space-4);font-size:19px;font-style:italic;line-height:1.6;margin-bottom:var(--space-6)">{work.data.quote}</div>
				<div class="prose"><Content /></div>
			</div>
		</div>

		{work.data.closingImage && (
			<div style="margin-top:var(--space-8)">
				<img src={work.data.closingImage} alt="" style="width:100%;height:320px;object-fit:cover" />
			</div>
		)}

		<div style="margin-top:var(--space-8);padding-top:var(--space-6);border-top:1px solid var(--color-divider);display:flex;flex-wrap:wrap;gap:var(--space-4);justify-content:space-between;align-items:center">
			<a href={`/works/${prevWork.id}`} class="btn btn-ghost" style="padding-inline:0">← 이전 프로젝트</a>
			<div style="display:flex;flex-direction:column;align-items:center;gap:var(--space-2)">
				<div style="font-size:13px;opacity:0.7">프로젝트를 준비하고 있나요?</div>
				<a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-secondary blueprint">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>Contact
				</a>
			</div>
			<a href={`/works/${nextWork.id}`} class="btn btn-ghost" style="padding-inline:0">다음 프로젝트 →</a>
		</div>
	</section>
	<Footer />
</body>
</html>
