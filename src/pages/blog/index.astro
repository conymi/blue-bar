---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const firstPost = posts[0];
const CATS = [
	{ key: 'ALL', label: '전체', desc: '모든 글' },
	{ key: 'LIFE', label: 'LIFE', desc: '몸과 생활, 살아가는 방식' },
	{ key: 'INFRA', label: 'INFRA', desc: '도시와 경제, 생활을 움직이는 구조' },
	{ key: 'DESIGN', label: 'DESIGN', desc: '제품과 브랜드, 경험을 만드는 설계' },
];
---
<!doctype html>
<html lang="ko">
<head><BaseHead title="웹진 | fluffy kkachi" description="세상 모든 관심사에 대한 이야기" image={firstPost?.data.heroImage} /></head>
<body>
	<Header />
	<section>
		{firstPost && (
			<a href={`/blog/${firstPost.id}`} style="display:block;position:relative;height:88vh;min-height:620px;overflow:hidden;margin-bottom:var(--space-8);text-decoration:none;color:inherit">
				<img src={firstPost.data.heroImage} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" />
				<div style="position:absolute;inset:0;background:linear-gradient(0deg, color-mix(in srgb, var(--color-prussian) 82%, transparent) 0%, transparent 45%, color-mix(in srgb, var(--color-prussian) 55%, transparent) 100%);z-index:1"></div>
				<div style="position:absolute;top:0;left:0;right:0;z-index:2;padding:var(--space-6);max-width:1280px;margin:0 auto;box-sizing:border-box">
					<div class="card-kicker" style="color:#fff;opacity:0.85;margin-bottom:var(--space-2)">WEBZINE</div>
					<h1 style="font-size:clamp(36px,5vw,60px);font-weight:800;color:var(--color-text);margin:0">fluffy kkachi</h1>
				</div>
				<div style="position:absolute;left:0;right:0;bottom:0;z-index:2;padding:var(--space-8) var(--space-6);max-width:1280px;margin:0 auto;box-sizing:border-box">
					<div class="card-kicker" style="color:#fff;opacity:0.85">{firstPost.data.tag} · {firstPost.data.pubDate.toISOString().slice(0,10)}</div>
					<div class="card-title" style="font-size:clamp(30px,4.2vw,52px);color:#fff">{firstPost.data.title}</div>
					<p class="card-body" style="color:rgba(255,255,255,0.85);font-size:17px;max-width:640px">{firstPost.data.dek}</p>
				</div>
			</a>
		)}

		<div class="container" style="padding-top:0">
			<div id="filters" style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:baseline;border-bottom:2px solid var(--color-twilight);padding-bottom:var(--space-4)">
				{CATS.map(c => (
					<button data-cat={c.key} class="tag cat-btn" style="cursor:pointer;border:none;font-weight:700;padding:8px 16px;font-size:14px;background:var(--color-neutral-200);color:var(--color-text)">{c.label}</button>
				))}
				<div id="cat-desc" style="font-size:13px;color:var(--color-emerald);padding-left:var(--space-2)">모든 글</div>
			</div>

			<div id="post-list" style="display:flex;flex-direction:column">
				{posts.map(p => (
					<a href={`/blog/${p.id}`} data-tag={p.data.tag} class="webzine-row" style="text-decoration:none;color:inherit;cursor:pointer;height:76px;box-sizing:border-box;overflow:hidden;padding:0 0 0 var(--space-3);border-bottom:1px solid var(--color-divider);border-left:3px solid transparent;display:flex;align-items:center;gap:var(--space-4)">
						<div class="tag tag-outline" style="width:90px;flex-shrink:0;text-align:center;padding-inline:12px;box-sizing:border-box;font-family:var(--font-heading);font-weight:700">{p.data.tag}</div>
						<div style="overflow:hidden;min-width:0;flex:1">
							<div class="card-title" style="font-size:20px;line-height:1.3;margin:0 0 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{p.data.title}</div>
							<div style="font-size:14px;line-height:1.3;opacity:0.65;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{p.data.dek}</div>
						</div>
						<div class="card-meta" style="width:100px;flex-shrink:0;text-align:right">{p.data.pubDate.toISOString().slice(0,10)}</div>
					</a>
				))}
			</div>
		</div>
	</section>
	<Footer />

	<script>
		const CATS: Record<string, string> = { ALL: '모든 글', LIFE: '몸과 생활, 살아가는 방식', INFRA: '도시와 경제, 생활을 움직이는 구조', DESIGN: '제품과 브랜드, 경험을 만드는 설계' };
		const btns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
		const rows = document.querySelectorAll<HTMLAnchorElement>('#post-list a');
		const descEl = document.getElementById('cat-desc')!;
		function select(cat: string) {
			btns.forEach(b => {
				const active = b.dataset.cat === cat;
				b.style.background = active ? 'var(--color-twilight)' : 'var(--color-neutral-200)';
				b.style.color = active ? '#fff' : 'var(--color-text)';
			});
			rows.forEach(r => { r.style.display = (cat === 'ALL' || r.dataset.tag === cat) ? 'flex' : 'none'; });
			descEl.textContent = CATS[cat];
		}
		btns.forEach(b => b.addEventListener('click', () => select(b.dataset.cat!)));
		select('ALL');
	</script>
</body>
</html>
