---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const works = (await getCollection('works')).filter(w => !w.data.draft).sort((a, b) => a.data.order - b.data.order);
const featuredWork = works.find(w => w.id === 'yongmaru-forest-festival') ?? works[0];
const secondaryWorks = works.filter(w => w.id !== featuredWork.id).slice(0, 2);

const cityQuestions = (await getCollection('cityQuestion')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const firstCityQuestion = cityQuestions[0];

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const firstPost = posts[0];
---
<!doctype html>
<html lang="ko">
<head>
	<BaseHead title={`${SITE_TITLE} | 콘텐츠 기획 스튜디오`} description={SITE_DESCRIPTION} />
</head>
<body>
	<Header />
	<section>
		<a href="/about" style="position:relative;height:92vh;min-height:520px;display:flex;align-items:flex-end;text-decoration:none;color:inherit">
			<img src="/images/home/hero.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" />
			<div style="position:absolute;inset:0;background:linear-gradient(0deg, color-mix(in srgb, var(--color-prussian) 82%, transparent) 0%, transparent 55%);z-index:1"></div>
			<div style="position:relative;z-index:2;padding:var(--space-8) var(--space-6);max-width:1280px;margin:0 auto;width:100%;box-sizing:border-box">
				<h1 style="font-size:clamp(30px,4.2vw,52px);color:#fff;margin-bottom:var(--space-4);line-height:1.3">익숙한 맥락 안에서,<br />새로운 흐름을 만듭니다.</h1>
				<p style="font-size:18px;color:rgba(255,255,255,0.82);max-width:560px;margin:0;line-height:1.7">지역과 사람, 콘텐츠 경험을 기획하고 기록합니다.</p>
			</div>
		</a>

		<div class="container">
			<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:var(--space-6)">
				<div class="card-kicker">SELECTED WORKS</div>
				<a href="/works" class="btn btn-ghost" style="color:#010862">전체보기 →</a>
			</div>
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:var(--space-4)">
				<a href={`/works/${featuredWork.id}`} class="card blueprint" style="position:relative;text-decoration:none;color:inherit;padding:0;overflow:hidden;justify-content:flex-end;flex:1.4 1 320px;min-height:340px">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
					<img src="/images/home/featured-work.jpg" alt={featuredWork.data.title} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" />
					<div style="position:relative;z-index:1;background:linear-gradient(0deg, color-mix(in srgb, var(--color-prussian) 80%, transparent), transparent 60%);padding:var(--space-6);min-height:340px;display:flex;flex-direction:column;justify-content:flex-end">
						<div class="card-kicker" style="color:#fff;opacity:0.8">{featuredWork.data.tag}</div>
						<div class="card-title" style="font-size:clamp(22px,2.4vw,30px);color:#fff">{featuredWork.data.title}</div>
					</div>
				</a>
				<div style="display:flex;flex-direction:column;gap:var(--space-3)">
					{secondaryWorks.map(w => (
						<a href={`/works/${w.id}`} class="card blueprint" style="text-decoration:none;color:inherit;padding:var(--space-4);flex:1;justify-content:space-between">
							<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
							<div class="card-kicker">{w.data.tag}</div>
							<div class="card-title" style="font-size:19px">{w.data.title}</div>
						</a>
					))}
				</div>
			</div>
		</div>

		{firstCityQuestion && (
			<div class="container" style="padding-top:0">
				<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:var(--space-4)">
					<div class="card-kicker">CURRENT QUESTION</div>
					<a href="/city-question" class="btn btn-ghost" style="color:#010862">도시질문 →</a>
				</div>
				<a href={`/city-question/${firstCityQuestion.id}`} class="card blueprint elev-sm" style="text-decoration:none;color:inherit;padding:0;overflow:hidden;flex-direction:row;flex-wrap:wrap">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
					<div style="flex:1 1 320px;min-height:260px">
						<img src={firstCityQuestion.data.heroImage} alt="" style="width:100%;height:100%;object-fit:cover" />
					</div>
					<div style="flex:1 1 320px;padding:var(--space-6);display:flex;flex-direction:column;justify-content:center;gap:var(--space-2)">
						<div class="card-kicker" style="color:#f43a11">도시질문 · {firstCityQuestion.data.code}</div>
						<div class="card-title" style="font-size:clamp(22px,2.6vw,32px)">{firstCityQuestion.data.title}</div>
						<p class="card-body">{firstCityQuestion.data.desc}</p>
					</div>
				</a>
			</div>
		)}

		{firstPost && (
			<div class="container" style="padding-top:0">
				<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:var(--space-4)">
					<div class="card-kicker">RECENT WRITING · fluffy kkachi</div>
					<a href="/blog" class="btn btn-ghost" style="color:#010862">웹진 →</a>
				</div>
				<a href={`/blog/${firstPost.id}`} class="card blueprint" style="text-decoration:none;color:inherit;padding:0;overflow:hidden;flex-direction:row;flex-wrap:wrap">
					<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
					<div style="flex:1 1 320px;min-height:260px">
						<img src={firstPost.data.heroImage} alt="" style="width:100%;height:100%;object-fit:cover" />
					</div>
					<div style="flex:1 1 320px;padding:var(--space-6);display:flex;flex-direction:column;justify-content:center;gap:var(--space-2)">
						<div class="card-kicker" style="color:#f43a11">{firstPost.data.tag} · {firstPost.data.pubDate.toISOString().slice(0,10)}</div>
						<div class="card-title" style="font-size:clamp(20px,2.2vw,26px)">{firstPost.data.title}</div>
						<p class="card-body">{firstPost.data.dek}</p>
					</div>
				</a>
			</div>
		)}

		<div class="container" style="padding-top:0;border-top:1px solid var(--color-divider);padding-top:var(--space-8)">
			<div class="card-kicker" style="margin-bottom:var(--space-3)">ABOUT MULKKACHI</div>
			<a href="/about" class="btn btn-ghost" style="padding-inline:0;color:#010862">소개 더 보기 →</a>
		</div>
	</section>
	<Footer />
</body>
</html>
