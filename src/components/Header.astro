---
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
const { pathname } = Astro.url;
const isActive = (p: string) => pathname === p || pathname.startsWith(p + '/');
---
<nav class="nav">
	<a href="/" class="nav-brand">{SITE_TITLE}</a>
	<a href="/works" aria-current={isActive('/works') ? 'page' : 'false'}>웍스</a>
	<a href="/city-question" aria-current={isActive('/city-question') ? 'page' : 'false'}>도시질문</a>
	<a href="/blog" aria-current={isActive('/blog') ? 'page' : 'false'}>웹진</a>
	<a href="/about" aria-current={isActive('/about') ? 'page' : 'false'}>소개</a>
	<a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-secondary blueprint">
		<i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>Contact
	</a>
</nav>
